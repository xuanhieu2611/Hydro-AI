# Copy to .env and fill in. Never commit real keys.
EXPO_PUBLIC_DATA_SOURCE=mock
# Set to 1 to use bundled sample photos instead of the real camera (the iOS
# simulator has no camera). Pairs with the mock analyzer; leave unset on device.
EXPO_PUBLIC_FAKE_CAMERA=0
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Google sign-in OAuth client IDs (see docs/AUTH_SETUP.md). The Web client id is
# the one Supabase's Google provider is configured with; the iOS client id is
# used by the native dialog. Not needed for EXPO_PUBLIC_DATA_SOURCE=mock.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<web-client-id>.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<ios-client-id>.apps.googleusercontent.com

# --- RevenueCat (hard paywall). See docs/PAYMENTS_SETUP.md. Public SDK keys are
# safe to ship (scoped to the signed-in customer); the secret API key stays in
# the RevenueCat dashboard. Only needed for EXPO_PUBLIC_DATA_SOURCE=supabase.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx
# Entitlement identifier that unlocks the app (RevenueCat → Entitlements). Must
# match EXACTLY, spaces included. The Hydro AI project's entitlement is
# "Hydro AI Premium" — leave it unquoted; dotenv keeps the spaces.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=Hydro AI Premium
# Optional: pin a specific offering; empty uses RevenueCat's "current" offering.
EXPO_PUBLIC_REVENUECAT_OFFERING=
# Dev only: force the paywall to show in mock mode (a "purchase" just unlocks it,
# no store needed). Pair with EXPO_PUBLIC_DATA_SOURCE=mock to iterate on the UI.
EXPO_PUBLIC_FORCE_PAYWALL=0
